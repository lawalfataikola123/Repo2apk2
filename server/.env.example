# ─── Server Configuration ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ─── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-string-at-least-32-chars
API_KEY_SECRET=another-random-secret-for-api-keys
# Optional: fine-grained GitHub token with Contents: Read-only for private source repos
GITHUB_TOKEN=

# ─── Build Configuration ──────────────────────────────────────────────────────
BUILD_TIMEOUT_MS=900000
MAX_REPO_SIZE_MB=500
BUILD_CLEANUP_HOURS=1

# ─── Android SDK ──────────────────────────────────────────────────────────────
ANDROID_HOME=/opt/android-sdk
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# ─── Flutter ─────────────────────────────────────────────────────────────────
FLUTTER_HOME=/opt/flutter

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Flutterwave Payments ────────────────────────────────────────────────────
# Set to the amount charged for one APK build, in whole NGN (e.g. 500).
BUILD_PRICE_NGN=
FLW_SECRET_KEY=
FLW_SECRET_HASH=
# Public HTTPS base URL of this backend, no trailing slash
API_BASE_URL=https://api.example.com
